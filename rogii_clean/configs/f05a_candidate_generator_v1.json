    "sc_trust",
    "hyb_d"
  ],
  "output_feature_count": 24,
  "output_conventions": {
    "delta_suffix_d": "candidate_TVT - last_known_tvt",
    "pf_vs_z": "pf_ancc - pf_z",
    "score_suffix_sc": "maximum normalized cross-correlation score"
